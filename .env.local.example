# Copy to .env.local and fill in values.
# For local dev, run `npx supabase status -o env` to print the local stack's
# URL and keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (spec 014). Feature is off unless all three are set.
# Use a dev bot locally; the prod bot goes in Vercel env vars.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
